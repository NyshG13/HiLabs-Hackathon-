# TermMap-X needs no API keys: every model runs locally and no data leaves the machine.
# All variables are optional overrides of termmap/config.py.

# Hugging Face cache location (defaults to ./models/hf_cache). Set HF_TOKEN only if you hit hub rate limits.
# HF_HOME=./models/hf_cache
# HF_TOKEN=

# Device: auto | cuda | cpu
TERMMAP_DEVICE=auto
# Step-8 local LLM adjudicator on low-confidence rows (1 = on, 0 = off)
TERMMAP_USE_LLM=1
TERMMAP_LLM=Qwen/Qwen2.5-1.5B-Instruct
# Fixed seed for every sampled step (split, synthetic variants, negatives, training order)
TERMMAP_SEED=13
# Confidence below which a prediction is flagged as abstain
TERMMAP_ABSTAIN=0.5
# ICD-10-CM release year for the CDC Index download (must match the supplied dictionary)
TERMMAP_CDC_YEAR=2026
